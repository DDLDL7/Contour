{
  "name": "contour-calculator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-math-runtime.mjs && tsc -b && vite build && node scripts/manifest-build.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:release": "vitest run --maxWorkers=2",
    "benchmark": "node --expose-gc --import tsx scripts/benchmark-math.ts",
    "release:mac": "node scripts/release-macos.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "mathjs": "^15.2.0",
    "mathlive": "^0.111.0",
    "pyodide": "314.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
